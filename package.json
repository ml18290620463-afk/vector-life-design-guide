{
  "name": "vector-life-design-guide",
  "private": true,
  "version": "1.1.0",
  "description": "Local-first VECTOR life design journal with encrypted storage, guiding-star reflection, and secure AI proxying.",
  "license": "MIT",
  "author": "VECTOR Life Design Guide contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ml18290620463-afk/vector-life-design-guide.git"
  },
  "homepage": "https://github.com/ml18290620463-afk/vector-life-design-guide#readme",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "i18n:diff": "tsx scripts/i18n-diff.ts",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "bench:argon2": "tsx scripts/argon2-bench.ts",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "audit:lighthouse:soft": "node scripts/lighthouse-audit.mjs --no-fail",
    "license:mint": "node scripts/dev-mint-license.mjs",
    "billing:smoke-bootstrap": "node scripts/billing-smoke-bootstrap.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml,css,html,cjs}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@google/genai": "^1.50.1",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "@sentry/node": "^10.51.0",
    "@sentry/react": "^10.50.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-virtual": "^3.13.24",
    "cmdk": "^1.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.7.0",
    "modern-screenshot": "^4.7.0",
    "motion": "^12.38.0",
    "qrcode-svg": "^1.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "stripe": "^22.1.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "web-vitals": "^4.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-themes": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/qrcode-svg": "^1.1.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "happy-dom": "^20.9.0",
    "hash-wasm": "^4.12.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.2.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "storybook": "^10.3.6",
    "supertest": "^7.2.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5",
    "workbox-window": "^7.4.0"
  }
}
