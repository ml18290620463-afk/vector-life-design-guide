# ----- AI Provider -----
# Choose which provider /api/morning-star should use.
# Leave empty for auto: prefer OpenRouter when its key is set, otherwise Gemini.
# Allowed: openrouter | gemini
AI_PROVIDER=

# ----- OpenRouter (recommended for free testing) -----
# Get a key at https://openrouter.ai/keys (free tier available).
# Free models are listed at https://openrouter.ai/models?free=true
# and exposed by this server at GET /api/models
OPENROUTER_API_KEY=
# Default model: google/gemma-3-12b-it:free routes through Google AI Studio
# and works with brand-new OpenRouter free keys without per-key spend setup.
# Other safe picks: google/gemma-3-27b-it:free (better quality, lower quota).
# See GET /api/models for the full live list.
OPENROUTER_MODEL=google/gemma-3-12b-it:free
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=VECTOR Life Design Guide
OPENROUTER_TIMEOUT_MS=60000
# Set true ONLY if your chosen model+provider supports JSON mode (most :free
# models do not). Leave false for max compatibility; the prompt itself will
# instruct the model to return JSON.
OPENROUTER_JSON_MODE=false

# ----- Google Gemini (fallback) -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ----- Observability -----
SENTRY_DSN=

# ----- Server -----
PORT=3000
# Default to loopback only. Set to 0.0.0.0 ONLY when intentionally exposing
# the server to other devices, and configure MORNING_STAR_ALLOWED_ORIGINS /
# MORNING_STAR_ACCESS_TOKEN below before doing so.
HOST=127.0.0.1
MORNING_STAR_RATE_LIMIT_WINDOW_MS=60000
MORNING_STAR_RATE_LIMIT_MAX=5
# Comma-separated list of browser Origins allowed to call /api/morning-star
# and /api/models. Leave empty to auto-allow http(s)://localhost:PORT and
# http(s)://127.0.0.1:PORT.
MORNING_STAR_ALLOWED_ORIGINS=
# Optional shared secret. When set, every /api/morning-star and /api/models
# request must send `Authorization: Bearer <token>`.
MORNING_STAR_ACCESS_TOKEN=

# ----- Vite dev -----
VITE_DEV_PORT=3000
VITE_DEV_HOST=127.0.0.1
