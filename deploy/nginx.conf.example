# Example nginx reverse proxy in front of the VECTOR Express server.
# Copy to deploy/nginx.conf, fill in your hostname / certificate paths,
# then enable the `nginx` service in docker-compose.yml.

events {}

http {
  include       mime.types;
  default_type  application/octet-stream;
  sendfile      on;
  keepalive_timeout 65;

  # Trust the Docker network so client IPs survive into express-rate-limit.
  set_real_ip_from 0.0.0.0/0;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  # gzip is fine for the static bundle; the Express server already handles
  # JSON, but Brotli is even better if you have the module compiled in.
  gzip on;
  gzip_types text/plain text/css application/json application/javascript text/javascript;

  upstream vector_app {
    server vector:3000;
    keepalive 16;
  }

  # HTTP -> HTTPS redirect.
  server {
    listen 80;
    server_name vector.example.com;
    return 301 https://$host$request_uri;
  }

  server {
    listen 443 ssl http2;
    server_name vector.example.com;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Mirror the security headers the express server sets and add HSTS for
    # production (the Express CSP is already strict; nginx just forwards it).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Forward everything to Express. The Express server serves both the SPA
    # shell and /api/* endpoints, so nginx does not need separate locations.
    location / {
      proxy_pass         http://vector_app;
      proxy_http_version 1.1;
      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $scheme;
      proxy_set_header   Connection        "";
      proxy_read_timeout 90s;
    }
  }
}
